/-!
# alg-d, Chapter 2: 例：単体的集合 (Example: simplicial sets)

Source: alg-d, 「全ての概念はKan拡張である」, Chapter 2, `simplex.pdf`
(<https://alg-d.com/math/kan_extension/simplex.pdf>), printed date 2026-10-18,
SHA-256 `728b18894d57b7471bec403811b6cfa6f93cc79de302e08e2d67b2210989a894`,
retrieved 2026-11-26. Ledger: `docs/ledger/algd/C2-SIMPLEX.md`.

## Conventions

* Δ is mathlib's `SimplexCategory`, with objects `⦋n⦌` and morphisms the monotone maps
  `Fin (m + 1) →o Fin (n + 1)`. The source's Set is `Type u`, so Δ̂ is `SSet.{u}`
  (`SimplexCategoryᵒᵖ ⥤ Type u`), and `X_k` is `X _⦋k⦌`.
* The standard simplex `Δ^n = y([n])` is mathlib's `Δ[n]`, defined with `uliftYoneda`; its
  `k`-simplices are the maps `⦋k⦌ ⟶ ⦋n⦌` through `stdSimplex.objEquiv`.
* The source's indices are shifted where mathlib's are: `δ^n_i : [n − 1] → [n]` is
  `SimplexCategory.δ i : ⦋n - 1⦌ ⟶ ⦋n⦌` with `i : Fin (n + 1)`, so statements for `n ≥ 1` are
  written for `n + 1`. `d^n_i` and `s^n_i` are `X.δ i` and `X.σ i`.
* Subsets of simplicial sets are mathlib's `Subcomplex` (subfunctors). The subset generated by
  `A ⊆ X_n` is `generated A`.
* Products of simplicial sets are written `X ⊗ Y`, the cartesian monoidal structure of `SSet`,
  whose `k`-simplices are `X_k × Y_k`.
* The source's `dim X ≤ n` is mathlib's `X.HasDimensionLE n`.
* `Δ_{≤n}`, `tr_n`, `sk_n` and `cosk_n` are `SimplexCategory.Truncated n`, `SSet.truncation n`,
  `SSet.Truncated.sk n` and `SSet.Truncated.cosk n`; `Sk_n = sk_n ∘ tr_n` and
  `Csk_n = cosk_n ∘ tr_n` are `SSet.sk n` and `SSet.cosk n`. The source's `η^n, ε^n` are the
  unit and counit of `SSet.skAdj n`, and `κ^n, μ^n` those of `SSet.coskAdj n`.
-/

@[expose] public section

namespace ProjectEpisteme.AlgD.Simplex

open CategoryTheory Limits Opposite Simplicial SSet SimplexCategory

universe w₁ w₂ v u v₁ u₁

/-! ## §1 Definitions and overview -/

/-- `ALGD-C2-SIMPLEX-D01` (定義, p.1).
`[n] = {0, …, n}` is an ordered set regarded as a category, and Δ is the full subcategory of Cat
on the `[n]`: `toCat` sends `⦋n⦌` to `Fin (n + 1)` and is fully faithful, and the morphisms of Δ
are the order-preserving maps. -/
theorem toCat_fullSubcategory :
    (∀ n : ℕ, (toCat.obj ⦋n⦌ : Type) = Fin (n + 1)) ∧
    (∀ m n : ℕ, Nonempty ((⦋m⦌ ⟶ ⦋n⦌) ≃ (Fin (m + 1) →o Fin (n + 1)))) ∧
    Nonempty toCat.FullyFaithful := by
  refine ⟨fun n ↦ rfl, fun m n ↦ ⟨SimplexCategory.homEquivOrderHom⟩, ⟨?_⟩⟩
  refine
    { preimage := fun {a b} F ↦ homEquivFunctor.symm F.toFunctor
      map_preimage := fun {a b} F ↦ ?_
      preimage_map := fun {a b} f ↦ ?_ }
  · ext
    rfl
  · ext x
    rfl

/-- `ALGD-C2-SIMPLEX-D02` (定義, p.1–2).
A simplicial set is a functor `Δ^op → Set` and a morphism is a natural transformation. The
standard `n`-simplex `Δ^n = y([n])` has `Δ^n_k = Hom_Δ([k], [n])`, and `y` is fully faithful. -/
theorem sSet_stdSimplex (n k : ℕ) :
    SSet.{u} = (SimplexCategoryᵒᵖ ⥤ Type u) ∧
    Nonempty ((Δ[n] : SSet.{u}) _⦋k⦌ ≃ (⦋k⦌ ⟶ ⦋n⦌)) ∧
    Nonempty stdSimplex.{u}.FullyFaithful :=
  ⟨rfl, ⟨stdSimplex.objEquiv⟩, ⟨stdSimplex.fullyFaithful⟩⟩

/-- `ALGD-C2-SIMPLEX-R01` (prose, p.2).
Every simplicial set is a colimit of standard simplices: `X` is the colimit of `Δ^n` over the
category of simplices `y ↓ X` (the diagram `CostructuredArrow.proj stdSimplex X ⋙ stdSimplex`). -/
theorem isColimit_stdSimplex (X : SSet.{u}) :
    Nonempty (IsColimit (Presheaf.tautologicalCocone'.{u} X)) :=
  ⟨Presheaf.isColimitTautologicalCocone' X⟩

/-- `ALGD-C2-SIMPLEX-D04` (prose, p.3).
For the inclusion `F : Δ → Cat`, the nerve `N = F†y` has `NC_n = Hom_Cat([n], C)`, the functors
`[n] → C`, with `NC(β)` given by precomposition with `F(β)`; the fundamental category
`τ₁ = y†F` is its left adjoint, mathlib's `hoFunctor ⊣ nerveFunctor`. -/
theorem nerve_adjunction :
    (∀ (C : Type u) [Category.{v} C] (n : ℕ), (nerve C _⦋n⦌) = (Fin (n + 1) ⥤ C)) ∧
    (∀ (C : Type u) [Category.{v} C] {m n : ℕ} (β : ⦋m⦌ ⟶ ⦋n⦌) (x : nerve C _⦋n⦌),
      (nerve C).map β.op x = (toCat.map β).toFunctor ⋙ x) ∧
    Nonempty (SSet.hoFunctor.{u} ⊣ nerveFunctor.{u, u}) :=
  ⟨fun _ _ _ ↦ rfl, fun _ _ _ _ _ _ ↦ rfl, ⟨nerveAdjunction⟩⟩

/-! ## §2 Basic structure -/

/-- `ALGD-C2-SIMPLEX-D05` (prose, p.3–4).
`δ^n_i : [n − 1] → [n]` skips `i`: `δ_i(x) = x` for `x < i` and `x + 1` for `i ≤ x`;
`σ^n_i : [n + 1] → [n]` repeats `i`: `σ_i(x) = x` for `x ≤ i` and `x − 1` for `i < x`.
For a simplicial set, `d_i = X(δ_i)` and `s_i = X(σ_i)`. -/
theorem δ_σ_spec {n : ℕ} :
    (∀ (i : Fin (n + 2)) (x : Fin (n + 1)),
      (((SimplexCategory.δ i).toOrderHom x : Fin (n + 2)) : ℕ) =
        if (x : ℕ) < i then (x : ℕ) else (x : ℕ) + 1) ∧
    (∀ (i : Fin (n + 1)) (x : Fin (n + 2)),
      (((SimplexCategory.σ i).toOrderHom x : Fin (n + 1)) : ℕ) =
        if (x : ℕ) ≤ i then (x : ℕ) else (x : ℕ) - 1) ∧
    (∀ (X : SSet.{u}) (i : Fin (n + 2)), X.δ i = X.map (SimplexCategory.δ i).op) ∧
    (∀ (X : SSet.{u}) (i : Fin (n + 1)), X.σ i = X.map (SimplexCategory.σ i).op) := by
  refine ⟨fun i x ↦ ?_, fun i x ↦ ?_, fun _ _ ↦ rfl, fun _ _ ↦ rfl⟩
  · change ((i.succAbove x : Fin (n + 2)) : ℕ) = _
    split_ifs with h
    · rw [Fin.succAbove_of_castSucc_lt _ _ (by simpa [Fin.lt_def] using h)]
      rfl
    · rw [Fin.succAbove_of_le_castSucc _ _ (by simpa [Fin.le_def] using h)]
      rfl
  · change ((i.predAbove x : Fin (n + 1)) : ℕ) = _
    split_ifs with h
    · rw [Fin.predAbove_of_le_castSucc _ _ (by simpa [Fin.le_def] using h)]
      rfl
    · rw [Fin.predAbove_of_castSucc_lt _ _ (by simpa [Fin.lt_def, not_le] using h)]
      simp

/-- `ALGD-C2-SIMPLEX-01` (命題 1, p.4).
Every morphism of Δ is a composite of `δ`s and `σ`s: a class of morphisms that contains the
identities, is closed under composition and contains every `δ_i` and `σ_i` contains every
morphism. -/
theorem mem_of_δ_σ (W : MorphismProperty SimplexCategory) [W.IsMultiplicative]
    (hδ : ∀ {n : ℕ} (i : Fin (n + 2)), W (SimplexCategory.δ i))
    (hσ : ∀ {n : ℕ} (i : Fin (n + 1)), W (SimplexCategory.σ i))
    {a b : SimplexCategory} (f : a ⟶ b) : W f := by
  rw [SimplexCategory.morphismProperty_eq_top W hδ hσ]
  trivial

/-- `ALGD-C2-SIMPLEX-02` (命題 2, p.4).
The cosimplicial identities, in mathlib's indexing: `δ_j ∘ δ_i = δ_i ∘ δ_{j−1}` (`i < j`),
`σ_j ∘ σ_i = σ_i ∘ σ_{j+1}` (`i ≤ j`), and `σ_j ∘ δ_i = δ_i ∘ σ_{j−1}` (`i < j`), `id`
(`i = j, j + 1`), `δ_{i−1} ∘ σ_j` (`i > j + 1`). -/
theorem cosimplicial_identities :
    (∀ {n : ℕ} {i j : Fin (n + 2)}, i ≤ j →
      SimplexCategory.δ i ≫ SimplexCategory.δ j.succ =
        SimplexCategory.δ j ≫ SimplexCategory.δ i.castSucc) ∧
    (∀ {n : ℕ} {i j : Fin (n + 1)}, i ≤ j →
      SimplexCategory.σ i.castSucc ≫ SimplexCategory.σ j =
        SimplexCategory.σ j.succ ≫ SimplexCategory.σ i) ∧
    (∀ {n : ℕ} {i : Fin (n + 2)} {j : Fin (n + 1)}, i ≤ j.castSucc →
      SimplexCategory.δ i.castSucc ≫ SimplexCategory.σ j.succ =
        SimplexCategory.σ j ≫ SimplexCategory.δ i) ∧
    (∀ {n : ℕ} {i : Fin (n + 1)},
      SimplexCategory.δ i.castSucc ≫ SimplexCategory.σ i = 𝟙 ⦋n⦌) ∧
    (∀ {n : ℕ} {i : Fin (n + 1)}, SimplexCategory.δ i.succ ≫ SimplexCategory.σ i = 𝟙 ⦋n⦌) ∧
    (∀ {n : ℕ} {i : Fin (n + 2)} {j : Fin (n + 1)}, j.castSucc < i →
      SimplexCategory.δ i.succ ≫ SimplexCategory.σ j.castSucc =
        SimplexCategory.σ j ≫ SimplexCategory.δ i) :=
  ⟨SimplexCategory.δ_comp_δ, SimplexCategory.σ_comp_σ, SimplexCategory.δ_comp_σ_of_le,
    SimplexCategory.δ_comp_σ_self, SimplexCategory.δ_comp_σ_succ,
    SimplexCategory.δ_comp_σ_of_gt⟩

/-- `ALGD-C2-SIMPLEX-R03` (prose after 命題 2, p.4–5).
The simplicial identities for `d_i = X(δ_i)` and `s_i = X(σ_i)`, obtained from 命題 2. -/
theorem simplicial_identities (X : SSet.{u}) :
    (∀ {n : ℕ} {i j : Fin (n + 2)}, i ≤ j → X.δ j.succ ≫ X.δ i = X.δ i.castSucc ≫ X.δ j) ∧
    (∀ {n : ℕ} {i j : Fin (n + 1)}, i ≤ j → X.σ j ≫ X.σ i.castSucc = X.σ i ≫ X.σ j.succ) ∧
    (∀ {n : ℕ} {i : Fin (n + 2)} {j : Fin (n + 1)}, i ≤ j.castSucc →
      X.σ j.succ ≫ X.δ i.castSucc = X.δ i ≫ X.σ j) ∧
    (∀ {n : ℕ} {i : Fin (n + 1)}, X.σ i ≫ X.δ i.castSucc = 𝟙 (X _⦋n⦌)) ∧
    (∀ {n : ℕ} {i : Fin (n + 1)}, X.σ i ≫ X.δ i.succ = 𝟙 (X _⦋n⦌)) ∧
    (∀ {n : ℕ} {i : Fin (n + 2)} {j : Fin (n + 1)}, j.castSucc < i →
      X.σ j.castSucc ≫ X.δ i.succ = X.δ i ≫ X.σ j) :=
  ⟨X.δ_comp_δ, X.σ_comp_σ, X.δ_comp_σ_of_le, X.δ_comp_σ_self, X.δ_comp_σ_succ,
    X.δ_comp_σ_of_gt⟩

/-! ### Subsets and generated subsets -/

section Generated

variable {X : SSet.{u}} {n : ℕ}

/-- The subset of `X` generated by `A ⊆ X_n` (p.5): the union of the subsets generated by the
single simplices `a ∈ A`. -/
def generated (A : Set (X _⦋n⦌)) : X.Subcomplex :=
  ⨆ a : A, Subcomplex.ofSimplex a.1

/-- `ALGD-C2-SIMPLEX-D06` (prose, p.5).
A subset `X ⊂ Y` is a family of subsets `X_k ⊆ Y_k` stable under the maps of `Y` (mathlib's
`Subcomplex`). For `A ⊆ X_n`, `generated A` is the smallest subset of `X` containing `A`. -/
theorem generated_spec (A : Set (X _⦋n⦌)) :
    A ⊆ (generated A).obj (op ⦋n⦌) ∧
    ∀ Y : X.Subcomplex, A ⊆ Y.obj (op ⦋n⦌) → generated A ≤ Y := by
  refine ⟨fun a ha ↦ ?_, fun Y hY ↦ iSup_le fun a ↦ (Subcomplex.ofSimplex_le_iff _ _).2 (hY a.2)⟩
  exact (le_iSup (fun a : A ↦ Subcomplex.ofSimplex a.1) ⟨a, ha⟩ : _) _
    (Subcomplex.mem_ofSimplex_obj a)

lemma mem_generated_iff (A : Set (X _⦋n⦌)) {m : SimplexCategoryᵒᵖ} (y : X.obj m) :
    y ∈ (generated A).obj m ↔ ∃ a ∈ A, ∃ β : m.unop ⟶ ⦋n⦌, X.map β.op a = y := by
  simp [generated, Subfunctor.iSup_obj, Subcomplex.mem_ofSimplex_obj_iff]

/-- `ALGD-C2-SIMPLEX-03` (命題 3, p.5).
If `Y` is the subset generated by `A ⊆ X_n`, then `Y_k = {Xβ(a) | a ∈ A, β : [k] → [n]}`. -/
theorem generated_obj (A : Set (X _⦋n⦌)) (k : ℕ) :
    (generated A).obj (op ⦋k⦌) = {y | ∃ a ∈ A, ∃ β : ⦋k⦌ ⟶ ⦋n⦌, X.map β.op a = y} := by
  ext y
  exact mem_generated_iff A y

/-- `ALGD-C2-SIMPLEX-04` (命題 4, p.5–6).
If `X` is generated by `A ⊆ X_n`, a morphism `f : X → Y` is determined by the `f_n(a)`,
`a ∈ A`. -/
theorem hom_ext_of_generated {A : Set (X _⦋n⦌)} (hA : generated A = ⊤) {Y : SSet.{u}}
    {f g : X ⟶ Y} (h : ∀ a ∈ A, f.app (op ⦋n⦌) a = g.app (op ⦋n⦌) a) : f = g := by
  ext m x
  have hx : x ∈ (generated A).obj m := by rw [hA]; trivial
  obtain ⟨a, ha, β, rfl⟩ := (mem_generated_iff A x).1 hx
  change f.app m (X.map β.op a) = g.app m (X.map β.op a)
  rw [NatTrans.naturality_apply, NatTrans.naturality_apply, h a ha]

lemma generated_singleton (a : X _⦋n⦌) : generated {a} = Subcomplex.ofSimplex a :=
  le_antisymm (iSup_le fun ⟨_, hb⟩ ↦ by obtain rfl := Set.mem_singleton_iff.1 hb; exact le_rfl)
    (le_iSup_of_le (⟨a, rfl⟩ : ({a} : Set (X _⦋n⦌))) le_rfl)

lemma generated_range {ι : Type*} (s : ι → X _⦋n⦌) :
    generated (Set.range s) = ⨆ i, Subcomplex.ofSimplex (s i) :=
  le_antisymm (iSup_le fun ⟨_, i, hi⟩ ↦ by subst hi; exact le_iSup_of_le i le_rfl)
    (iSup_le fun i ↦ le_iSup_of_le (⟨s i, i, rfl⟩ : Set.range s) le_rfl)

end Generated

/-- `ALGD-C2-SIMPLEX-05` (例 5, p.6).
`Δ^n` is generated by `{id_[n]} ⊆ Δ^n_n`. -/
theorem stdSimplex_generated (n : ℕ) :
    generated {stdSimplex.objEquiv.symm (𝟙 ⦋n⦌)} = (⊤ : (Δ[n] : SSet.{u}).Subcomplex) := by
  refine eq_top_iff.2 fun m y _ ↦ (mem_generated_iff _ y).2 ⟨_, rfl, stdSimplex.objEquiv y, ?_⟩
  rw [stdSimplex.map_objEquiv_symm]
  exact stdSimplex.objEquiv.symm_apply_eq.2 (Category.comp_id _)

/-- `ALGD-C2-SIMPLEX-06` (例 6, p.6–7).
For `n ≥ 1` and `0 ≤ k ≤ n`, the subset `∂_k Δ^n` generated by `{δ^n_k}` is the face of `Δ^n`
opposite to `k`, and it is isomorphic to `Δ^{n−1}`, the isomorphism followed by the inclusion
being `y(δ^n_k)`. -/
theorem face_generated {n : ℕ} (k : Fin (n + 2)) :
    generated {stdSimplex.objEquiv.symm (SimplexCategory.δ k)} =
      (stdSimplex.face {k}ᶜ : (Δ[n + 1] : SSet.{u}).Subcomplex) ∧
    (stdSimplex.faceSingletonComplIso.{u} k).hom ≫ (stdSimplex.face {k}ᶜ).ι =
      stdSimplex.δ k := by
  refine ⟨?_, stdSimplex.faceSingletonComplIso_hom_ι k⟩
  rw [generated_singleton, stdSimplex.face_singleton_compl]

/-! ## §3 Geometric realization: horns, boundaries and Kan complexes -/

/-- `ALGD-C2-SIMPLEX-D07` (定義 (1), p.7–8).
For `n ≥ 1`, the simplicial `(n − 1)`-sphere `∂Δ^n` is the subset of `Δ^n` generated by the
faces `{δ^n_i | 0 ≤ i ≤ n}`. -/
theorem boundary_eq_generated (n : ℕ) :
    (∂Δ[n + 1] : (Δ[n + 1] : SSet.{u}).Subcomplex) =
      generated (Set.range fun i : Fin (n + 2) ↦ stdSimplex.objEquiv.symm (SimplexCategory.δ i)) := by
  rw [boundary_eq_iSup, generated_range]
  simp_rw [stdSimplex.face_singleton_compl]

/-- `ALGD-C2-SIMPLEX-D08` (定義 (2), (3), p.8).
For `n ≥ 1` and `0 ≤ k ≤ n`, the horn `Λ^{n,k}` is the subset of `Δ^n` generated by
`{δ^n_i | i ≠ k}`; it is inner for `0 < k < n` and outer for `k = 0, n`, and `inc` is its
inclusion `Λ[n, k].ι`. -/
theorem horn_eq_generated (n : ℕ) (k : Fin (n + 2)) :
    (Λ[n + 1, k] : (Δ[n + 1] : SSet.{u}).Subcomplex) =
      generated (Set.range fun i : ({k}ᶜ : Set (Fin (n + 2))) ↦
        stdSimplex.objEquiv.symm (SimplexCategory.δ i.1)) := by
  rw [horn_eq_iSup, generated_range]
  simp_rw [stdSimplex.face_singleton_compl]

/-- `ALGD-C2-SIMPLEX-D10` (定義 (Kan 複体), p.13).
`X` is a Kan complex iff for `n ≥ 1` and `0 ≤ k ≤ n` every `f : Λ^{n,k} → X` extends along
`inc : Λ^{n,k} → Δ^n`. mathlib defines Kan complexes as the fibrant objects of the Quillen model
structure. -/
theorem kanComplex_iff (X : SSet.{u}) :
    X.KanComplex ↔ ∀ (n : ℕ) (k : Fin (n + 2)) (f : (Λ[n + 1, k] : SSet.{u}) ⟶ X),
      ∃ h : Δ[n + 1] ⟶ X, Λ[n + 1, k].ι ≫ h = f := by
  refine ⟨fun _ n k f ↦ ?_, fun H ↦ KanComplex.iff.2 fun n k f hf ↦ ?_⟩
  · obtain ⟨h, hh⟩ := KanComplex.hornFilling f
    exact ⟨h, hh.symm⟩
  · obtain ⟨h, hh⟩ := H n k hf.desc
    exact ⟨h, fun j hj ↦ by rw [← horn.ι_ι k j hj, Category.assoc, hh, hf.ι_desc]⟩


/-! ## §4 Simplicial sets as diagrams; nerves -/

/-- `ALGD-C2-SIMPLEX-R04` (prose, p.14).
`NC_n ≅ Hom_Cat([n], C)`, i.e. an element of `NC_n` is a diagram `a₀ → ⋯ → aₙ` in `C`; `d_i`
deletes `a_i` (composing at `a_i` when `0 < i < n`) and `s_i` repeats `a_i` with an identity.
In particular `d^1_0(p) = cod p`, `d^1_1(p) = dom p`, `d^2_1(a → b → c) = (a → c)` (the
composite) and `s^0_0(a) = id_a`. -/
theorem nerve_faces (C : Type u) [Category.{v} C] :
    (∀ n : ℕ, (nerve C _⦋n⦌) = (Fin (n + 1) ⥤ C)) ∧
    (∀ {n : ℕ} (i : Fin (n + 2)) (x : nerve C _⦋n + 1⦌) (j : Fin (n + 1)),
      ((nerve C).δ i x).obj j = x.obj (i.succAbove j)) ∧
    (∀ {a b : C} (p : a ⟶ b), ((nerve C).δ 0 (ComposableArrows.mk₁ p)).obj 0 = b ∧
      ((nerve C).δ 1 (ComposableArrows.mk₁ p)).obj 0 = a) ∧
    (∀ {a b c : C} (p : a ⟶ b) (q : b ⟶ c),
      (nerve C).δ 1 (ComposableArrows.mk₂ p q) = ComposableArrows.mk₁ (p ≫ q)) ∧
    (∀ a : C, (nerve C).σ 0 (ComposableArrows.mk₀ a) = ComposableArrows.mk₁ (𝟙 a)) :=
  ⟨fun _ ↦ rfl, fun i x j ↦ nerve.δ_obj i x j, fun _ ↦ ⟨rfl, rfl⟩,
    fun p q ↦ nerve.δ₁_mk₂_eq p q, fun a ↦ nerve.σ₀_mk₀_eq a⟩

/-- `ALGD-C2-SIMPLEX-D11` (prose, p.19).
`γ^n_{ij} : [1] → [n]` sends `0 ↦ i` and `1 ↦ j` (mathlib's `mkOfLe i j`), and
`γ^n_i := γ^n_{i,i+1}` (mathlib's `mkOfSucc i`). -/
theorem gamma_spec {n : ℕ} :
    (∀ (i j : Fin (n + 1)) (h : i ≤ j),
      (mkOfLe i j h).toOrderHom 0 = i ∧ (mkOfLe i j h).toOrderHom 1 = j) ∧
    (∀ i : Fin n, mkOfSucc i = mkOfLe i.castSucc i.succ (Fin.castSucc_le_succ i)) := by
  refine ⟨fun _ _ _ ↦ ⟨rfl, rfl⟩, fun i ↦ ?_⟩
  ext x
  fin_cases x <;> rfl

/-- The edges `f₁(γ_i)` of `f : Δ^{n+1} → X` are the edges of the spine of the corresponding
simplex. -/
lemma spine_arrow_yonedaEquiv {X : SSet.{u}} {n : ℕ} (f : Δ[n] ⟶ X) (i : Fin n) :
    (X.spine n (yonedaEquiv f)).arrow i =
      f.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i)) := by
  rw [spine_arrow, yonedaEquiv_naturality, yonedaEquiv_comp, SSet.yonedaEquiv_map]

/-- A morphism `Δ^{n+1} → X` to a strict Segal simplicial set is determined by its edges
`f₁(γ_i)`. -/
lemma hom_ext_of_isStrictSegal {X : SSet.{u}} [X.IsStrictSegal] {n : ℕ} {f g : Δ[n + 1] ⟶ X}
    (h : ∀ i : Fin (n + 1), f.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i)) =
      g.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i))) : f = g := by
  apply yonedaEquiv.injective
  apply (IsStrictSegal.segal (X := X) (n + 1)).1
  apply Path.ext'
  intro i
  rw [spine_arrow_yonedaEquiv, spine_arrow_yonedaEquiv]
  exact h i

/-- `ALGD-C2-SIMPLEX-13` (補題 13, p.20).
For a small category `C`, a morphism `f : Δ^n → NC` (`n ≥ 1`) is determined by
`f₁(γ^n_0), …, f₁(γ^n_{n−1})`. -/
theorem nerve_hom_ext {C : Type u} [Category.{v} C] {n : ℕ}
    {f g : (Δ[n + 1] : SSet.{max u v}) ⟶ nerve C}
    (h : ∀ i : Fin (n + 1), f.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i)) =
      g.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i))) : f = g :=
  hom_ext_of_isStrictSegal h

/-- `ALGD-C2-SIMPLEX-14` (例 14, p.20–21).
For `n = 3`: `f : Δ^3 → NC` is determined by the three edges `f₁(γ^3_0), f₁(γ^3_1), f₁(γ^3_2)`,
and `f₁(γ^3_0) = d^2_2(d^3_3(x))` for the corresponding `x ∈ NC_3`, since
`γ^3_0 = δ^3_3 ∘ δ^2_2`. -/
theorem nerve_three_simplex {C : Type u} [Category.{v} C] :
    (∀ f g : (Δ[3] : SSet.{max u v}) ⟶ nerve C,
      (∀ i : Fin 3, f.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i)) =
        g.app (op ⦋1⦌) (stdSimplex.objEquiv.symm (mkOfSucc i))) → f = g) ∧
    mkOfSucc (0 : Fin 3) = SimplexCategory.δ 2 ≫ SimplexCategory.δ 3 ∧
    ∀ (X : SSet.{u}) (x : X _⦋3⦌), X.map (mkOfSucc (0 : Fin 3)).op x = X.δ 2 (X.δ 3 x) := by
  have hγ : mkOfSucc (0 : Fin 3) = SimplexCategory.δ 2 ≫ SimplexCategory.δ 3 := by
    ext x
    fin_cases x <;> rfl
  refine ⟨fun f g h ↦ nerve_hom_ext (n := 2) h, hγ, fun X x ↦ ?_⟩
  rw [hγ, op_comp, Functor.map_comp]
  rfl

/-! ## §5 Dimension -/

/-! ### Absolute colimits -/

section Absolute

variable {C : Type u₁} [Category.{v₁} C]

/-- `ALGD-C2-SIMPLEX-D12` (定義, p.25).
A colimit `colim T` is absolute if every functor `F : C → D` preserves it. The test categories
`D` range over one universe pair `Type w₂`, `Category.{w₁}`. -/
def IsAbsoluteColimit {J : Type*} [Category J] {T : J ⥤ C} (c : Cocone T) : Prop :=
  ∀ (D : Type w₂) [Category.{w₁} D] (F : C ⥤ D), Nonempty (IsColimit (F.mapCocone c))

/-- An absolute colimit cocone is a colimit cocone (take `F = 𝟭 C`). -/
theorem IsAbsoluteColimit.isColimit {J : Type*} [Category J] {T : J ⥤ C} {c : Cocone T}
    (h : IsAbsoluteColimit.{v₁, u₁} c) : Nonempty (IsColimit c) :=
  h C (𝟭 C)

/-- The pushout half of 補題 18. -/
theorem isPushout_of_sections {a b c d : C} {p₀ : a ⟶ b} {p₁ : a ⟶ c} {p₂ : b ⟶ d}
    {p₃ : c ⟶ d} {s₀ : b ⟶ a} {s₁ : c ⟶ a} {s₂ : d ⟶ b} {s₃ : d ⟶ c}
    (w : p₀ ≫ p₂ = p₁ ≫ p₃) (ws : s₂ ≫ s₀ = s₃ ≫ s₁) (w₁ : s₁ ≫ p₀ = p₃ ≫ s₂)
    (w₂ : s₀ ≫ p₁ = p₂ ≫ s₃) (h₀ : s₀ ≫ p₀ = 𝟙 b) (h₁ : s₁ ≫ p₁ = 𝟙 c)
    (h₂ : s₂ ≫ p₂ = 𝟙 d) : IsPushout p₀ p₁ p₂ p₃ := by
  have key : ∀ s : PushoutCocone p₀ p₁, s₂ ≫ s.inl = s₃ ≫ s.inr := fun s ↦ by
    calc s₂ ≫ s.inl = s₂ ≫ s₀ ≫ p₀ ≫ s.inl := by rw [reassoc_of% h₀]
      _ = s₃ ≫ s₁ ≫ p₁ ≫ s.inr := by rw [s.condition, reassoc_of% ws]
      _ = s₃ ≫ s.inr := by rw [reassoc_of% h₁]
  refine IsPushout.of_isColimit (PushoutCocone.IsColimit.mk w (fun s ↦ s₂ ≫ s.inl)
    (fun s ↦ ?_) (fun s ↦ ?_) (fun s m hl _ ↦ ?_))
  · calc p₂ ≫ s₂ ≫ s.inl = p₂ ≫ s₃ ≫ s.inr := by rw [key]
      _ = s₀ ≫ p₁ ≫ s.inr := by rw [reassoc_of% w₂]
      _ = s₀ ≫ p₀ ≫ s.inl := by rw [s.condition]
      _ = s.inl := by rw [reassoc_of% h₀]
  · calc p₃ ≫ s₂ ≫ s.inl = s₁ ≫ p₀ ≫ s.inl := by rw [reassoc_of% w₁]
      _ = s₁ ≫ p₁ ≫ s.inr := by rw [s.condition]
      _ = s.inr := by rw [reassoc_of% h₁]
  · calc m = s₂ ≫ p₂ ≫ m := by rw [reassoc_of% h₂]
      _ = s₂ ≫ s.inl := by rw [hl]

/-- `ALGD-C2-SIMPLEX-18` (補題 18, p.25–28).
Given `p₀ : a → b`, `p₁ : a → c`, `p₂ : b → d`, `p₃ : c → d` and `s₀ : b → a`, `s₁ : c → a`,
`s₂ : d → b`, `s₃ : d → c` such that the squares `p₂p₀ = p₃p₁`, `s₀s₂ = s₁s₃`, `p₀s₁ = s₂p₃`,
`p₁s₀ = s₃p₂` commute and `p_i s_i = id`, the square `p₂p₀ = p₃p₁` is an absolute pushout. -/
theorem isAbsolutePushout_of_sections {a b c d : C} {p₀ : a ⟶ b} {p₁ : a ⟶ c} {p₂ : b ⟶ d}
    {p₃ : c ⟶ d} {s₀ : b ⟶ a} {s₁ : c ⟶ a} {s₂ : d ⟶ b} {s₃ : d ⟶ c}
    (w : p₀ ≫ p₂ = p₁ ≫ p₃) (ws : s₂ ≫ s₀ = s₃ ≫ s₁) (w₁ : s₁ ≫ p₀ = p₃ ≫ s₂)
    (w₂ : s₀ ≫ p₁ = p₂ ≫ s₃) (h₀ : s₀ ≫ p₀ = 𝟙 b) (h₁ : s₁ ≫ p₁ = 𝟙 c)
    (h₂ : s₂ ≫ p₂ = 𝟙 d) (_h₃ : s₃ ≫ p₃ = 𝟙 d) :
    IsPushout p₀ p₁ p₂ p₃ ∧ IsAbsoluteColimit.{w₁, w₂} (PushoutCocone.mk p₂ p₃ w) := by
  refine ⟨isPushout_of_sections w ws w₁ w₂ h₀ h₁ h₂, fun D _ F ↦ ⟨?_⟩⟩
  have hF : IsPushout (F.map p₀) (F.map p₁) (F.map p₂) (F.map p₃) :=
    isPushout_of_sections (s₀ := F.map s₀) (s₁ := F.map s₁) (s₂ := F.map s₂) (s₃ := F.map s₃)
      (by simp only [← F.map_comp, w]) (by simp only [← F.map_comp, ws])
      (by simp only [← F.map_comp, w₁]) (by simp only [← F.map_comp, w₂])
      (by rw [← F.map_comp, h₀, F.map_id]) (by rw [← F.map_comp, h₁, F.map_id])
      (by rw [← F.map_comp, h₂, F.map_id])
  exact (isColimitMapCoconePushoutCoconeEquiv F w).symm hF.isColimit

end Absolute

/-! ### Degenerate simplices and dimension -/

/-- `ALGD-C2-SIMPLEX-D13` (定義, p.28).
`x ∈ X_n` is degenerate iff `x = s^{n−1}_i(a)` for some `a ∈ X_{n−1}` and `0 ≤ i ≤ n − 1`; with
`X_{−1} = ∅`, no element of `X_0` is degenerate. mathlib's `degenerate` (in the image of some
`X(f)` with `f : [n] → [m]`, `m < n`) is this set. -/
theorem degenerate_spec (X : SSet.{u}) :
    (∀ n : ℕ, X.degenerate (n + 1) = ⋃ i : Fin (n + 1), Set.range (X.σ i)) ∧
    X.degenerate 0 = ∅ :=
  ⟨fun _ ↦ X.degenerate_eq_iUnion_range_σ, X.degenerate_zero⟩

/-- `ALGD-C2-SIMPLEX-19` (命題 19, Eilenberg–Zilber の補題, p.28–29).
Every `u ∈ X_n` is `Xβ(v)` for some `k`, a nondegenerate `v ∈ X_k` and a surjection
`β : [n] → [k]`; and `k`, `β` and `v` are unique. -/
theorem eilenberg_zilber (X : SSet.{u}) {n : ℕ} (x : X _⦋n⦌) :
    (∃ (k : ℕ) (β : ⦋n⦌ ⟶ ⦋k⦌) (_ : Epi β) (v : X.nonDegenerate k), X.map β.op v.1 = x) ∧
    (∀ {k l : ℕ} (β : ⦋n⦌ ⟶ ⦋k⦌) [Epi β] (v : X.nonDegenerate k) (θ : ⦋n⦌ ⟶ ⦋l⦌) [Epi θ]
      (w : X.nonDegenerate l), X.map β.op v.1 = x → X.map θ.op w.1 = x → k = l) ∧
    (∀ {k : ℕ} (β θ : ⦋n⦌ ⟶ ⦋k⦌) [Epi β] [Epi θ] (v w : X.nonDegenerate k),
      X.map β.op v.1 = x → X.map θ.op w.1 = x → β = θ ∧ v = w) := by
  refine ⟨?_, fun β _ v θ _ w hv hw ↦ X.unique_nonDegenerate_dim x β v hv.symm θ w hw.symm,
    fun β θ _ _ v w hv hw ↦ ⟨X.unique_nonDegenerate_map x β v hv.symm θ w hw.symm,
      X.unique_nonDegenerate_simplex x β v hv.symm θ w hw.symm⟩⟩
  obtain ⟨k, β, hβ, v, hv⟩ := X.exists_nonDegenerate x
  exact ⟨k, β, hβ, v, hv.symm⟩

/-- The source's `dim X = n`: `dim X ≤ n` holds and `dim X ≤ n − 1` does not (for `n = 0`,
`dim X ≤ −1` is `X.HasDimensionLT 0`). -/
def HasDimension (X : SSet.{u}) (n : ℕ) : Prop :=
  X.HasDimensionLE n ∧ ¬ X.HasDimensionLT n

lemma hasDimensionLE_iff (X : SSet.{u}) (n : ℕ) :
    X.HasDimensionLE n ↔ ∀ k, n < k → ∀ x : X _⦋k⦌, x ∈ X.degenerate k := by
  refine ⟨fun h k hk x ↦ ?_, fun h ↦ ⟨fun k hk ↦ Set.eq_univ_of_forall (h k hk)⟩⟩
  rw [h.degenerate_eq_top k hk]
  trivial

/-- `ALGD-C2-SIMPLEX-D14` (定義, p.29).
`dim X ≤ n` iff every `x ∈ X_k` with `k > n` is degenerate (mathlib's `HasDimensionLE`), and
`dim X = n` (`HasDimension X n`) determines `n`. -/
theorem hasDimension_spec (X : SSet.{u}) :
    (∀ n : ℕ, X.HasDimensionLE n ↔ ∀ k, n < k → ∀ x : X _⦋k⦌, x ∈ X.degenerate k) ∧
    ∀ {n m : ℕ}, HasDimension X n → HasDimension X m → n = m := by
  refine ⟨hasDimensionLE_iff X, fun {n m} hn hm ↦ ?_⟩
  have key : ∀ {a b : ℕ}, HasDimension X a → HasDimension X b → ¬ a < b := fun {a b} ha hb hab ↦
    hb.2 ⟨fun k hk ↦ ha.1.degenerate_eq_top k (by omega)⟩
  exact le_antisymm (not_lt.1 (key hm hn)) (not_lt.1 (key hn hm))

/-- `ALGD-C2-SIMPLEX-20` (命題 20, p.30).
If `X` is generated by `A ⊆ X_n`, then `dim X ≤ n`. -/
theorem hasDimensionLE_of_generated {X : SSet.{u}} {n : ℕ} {A : Set (X _⦋n⦌)}
    (hA : generated A = ⊤) : X.HasDimensionLE n := by
  refine (hasDimensionLE_iff X n).2 fun k hk x ↦ ?_
  have hx : x ∈ (generated A).obj (op ⦋k⦌) := by rw [hA]; trivial
  obtain ⟨a, _, β, rfl⟩ := (mem_generated_iff A x).1 hx
  exact ⟨n, hk, β, a, rfl⟩

/-- `ALGD-C2-SIMPLEX-22` (命題 22, p.31).
A morphism of simplicial sets sends degenerate elements to degenerate elements. -/
theorem degenerate_map {X Y : SSet.{u}} (f : X ⟶ Y) {n : ℕ} {x : X _⦋n⦌}
    (hx : x ∈ X.degenerate n) : f.app (op ⦋n⦌) x ∈ Y.degenerate n :=
  degenerate_app_apply hx f

/-- `ALGD-C2-SIMPLEX-23` (命題 23, p.31).
If `f_n` and `f_{n−1}` are bijective, `f_n` sends nondegenerate elements to nondegenerate
elements. -/
theorem nonDegenerate_map_of_bijective {X Y : SSet.{u}} (f : X ⟶ Y) {n : ℕ}
    (hn : Function.Bijective (f.app (op ⦋n + 1⦌))) (hn' : Function.Surjective (f.app (op ⦋n⦌)))
    {x : X _⦋n + 1⦌} (hx : x ∈ X.nonDegenerate (n + 1)) :
    f.app (op ⦋n + 1⦌) x ∈ Y.nonDegenerate (n + 1) := by
  rw [mem_nonDegenerate_iff_notMem_degenerate] at hx ⊢
  intro hfx
  rw [Y.degenerate_eq_iUnion_range_σ, Set.mem_iUnion] at hfx
  obtain ⟨i, a, ha⟩ := hfx
  obtain ⟨b, rfl⟩ := hn' a
  apply hx
  rw [X.degenerate_eq_iUnion_range_σ, Set.mem_iUnion]
  refine ⟨i, b, hn.1 ?_⟩
  rw [σ_naturality_apply]
  exact ha

/-- `ALGD-C2-SIMPLEX-21` (例 21, p.30).
`dim Δ^n = n` (by 例 5 and 命題 20, and `id_[n]` is nondegenerate); the nondegenerate elements
of `Δ^n_d` are the injective order-preserving maps `[d] → [n]`, which gives the pictures of
`Δ^0`, `Δ^1` and `Δ^2`; and `dim Λ^{2,0} = 1`. -/
theorem stdSimplex_hasDimension (n : ℕ) :
    HasDimension (Δ[n] : SSet.{u}) n ∧
    (∀ d : ℕ, Nonempty ((Δ[n] : SSet.{u}).nonDegenerate d ≃ (Fin (d + 1) ↪o Fin (n + 1)))) ∧
    HasDimension (Λ[2, 0] : SSet.{u}) 1 := by
  refine ⟨⟨hasDimensionLE_of_generated (stdSimplex_generated n),
    fun h ↦ stdSimplex.not_hasDimensionLT n h⟩, fun d ↦ ⟨stdSimplex.nonDegenerateEquiv⟩, ?_, ?_⟩
  · change (Λ[2, 0] : SSet.{u}).HasDimensionLT 2
    rw [horn_eq_iSup, hasDimensionLT_iSup_iff]
    intro j
    exact hasDimensionLT_of_epi (stdSimplex.faceSingletonComplIso.{u} j.1).hom 2
  · intro h
    have h1 : Λ[2, 0].ι.app (op ⦋1⦌) (horn.face (0 : Fin 3) 1 (by decide)) ∈
        (Δ[2] : SSet.{u}).nonDegenerate 1 := by
      rw [← horn.yonedaEquiv_ι, ← yonedaEquiv_comp, horn.ι_ι,
        stdSimplex.mem_nonDegenerate_iff_mono]
      change Mono (stdSimplex.objEquiv (yonedaEquiv (stdSimplex.map (SimplexCategory.δ 1))))
      rw [SSet.yonedaEquiv_map, Equiv.apply_symm_apply]
      infer_instance
    rw [nonDegenerate_iff_of_mono, mem_nonDegenerate_iff_notMem_degenerate] at h1
    exact h1 (by rw [h.degenerate_eq_top 1 le_rfl]; trivial)

/-- `ALGD-C2-SIMPLEX-24` (系 24, p.31).
Isomorphic simplicial sets have the same dimension. -/
theorem hasDimension_iff_of_iso {X Y : SSet.{u}} (e : X ≅ Y) :
    (∀ d : ℕ, X.HasDimensionLT d ↔ Y.HasDimensionLT d) ∧
    ∀ n : ℕ, HasDimension X n ↔ HasDimension Y n := by
  have h : ∀ d : ℕ, X.HasDimensionLT d ↔ Y.HasDimensionLT d := fun d ↦
    ⟨fun _ ↦ hasDimensionLT_of_epi e.hom d, fun _ ↦ hasDimensionLT_of_mono e.hom d⟩
  exact ⟨h, fun n ↦ and_congr (h (n + 1)) (not_congr (h n))⟩

/-- `ALGD-C2-SIMPLEX-25` (命題 25, p.31).
For a small category `J` and `T : J → Δ̂` with `dim(Tj) ≤ n` for every `j`,
`dim(colim T) ≤ n`. -/
theorem hasDimensionLE_of_isColimit {J : Type u} [SmallCategory J] {T : J ⥤ SSet.{u}}
    {c : Cocone T} (hc : IsColimit c) {n : ℕ} (h : ∀ j, (T.obj j).HasDimensionLE n) :
    c.pt.HasDimensionLE n :=
  hasDimensionLT_of_isColimit hc h

open MonoidalCategory in
/-- `ALGD-C2-SIMPLEX-27` (系 27, p.34).
If `dim X ≤ n` and `dim Y ≤ m`, then `dim(X × Y) ≤ n + m`. -/
theorem hasDimensionLE_prod (X Y : SSet.{u}) (n m : ℕ) [X.HasDimensionLE n]
    [Y.HasDimensionLE m] : (X ⊗ Y).HasDimensionLE (n + m) :=
  SSet.hasDimensionLE_prod X Y n m (n + m)

/-! ### Skeleta and coskeleta -/

/-- The adjunction `Sk_n ⊣ Csk_n`, composed from `sk_n ⊣ tr_n` and `tr_n ⊣ cosk_n`. -/
noncomputable def skCoskAdj (n : ℕ) : SSet.sk.{u} n ⊣ SSet.cosk n :=
  (SSet.coskAdj n).comp (SSet.skAdj n)

/-- `ALGD-C2-SIMPLEX-D15` (prose, p.40).
`Δ_{≤n}` is the full subcategory on `[0], …, [n]`; `tr_n = F⁻¹` is restriction along its
inclusion `F`, with left adjoint `sk_n = F†` and right adjoint `cosk_n = F‡`; and
`Sk_n := sk_n ∘ tr_n ⊣ Csk_n := cosk_n ∘ tr_n`. -/
theorem truncation_spec (n : ℕ) :
    SSet.truncation.{u} n =
      (Functor.whiskeringLeft _ _ _).obj (SimplexCategory.Truncated.inclusion n).op ∧
    SSet.Truncated.sk.{u} n = (SimplexCategory.Truncated.inclusion n).op.lan ∧
    SSet.Truncated.cosk.{u} n = (SimplexCategory.Truncated.inclusion n).op.ran ∧
    SSet.sk.{u} n = SSet.truncation n ⋙ SSet.Truncated.sk n ∧
    SSet.cosk.{u} n = SSet.truncation n ⋙ SSet.Truncated.cosk n ∧
    Nonempty (SSet.Truncated.sk.{u} n ⊣ SSet.truncation n) ∧
    Nonempty (SSet.truncation.{u} n ⊣ SSet.Truncated.cosk n) ∧
    Nonempty (SSet.sk.{u} n ⊣ SSet.cosk n) :=
  ⟨rfl, rfl, rfl, rfl, rfl, ⟨SSet.skAdj n⟩, ⟨SSet.coskAdj n⟩, ⟨skCoskAdj n⟩⟩

lemma isIso_truncation_map_skAdj_counit_app (n : ℕ) (X : SSet.{u}) :
    IsIso ((SSet.truncation n).map ((SSet.skAdj n).counit.app X)) :=
  IsIso.of_isIso_fac_left (hh := IsIso.id _) ((SSet.skAdj n).right_triangle_components X)

lemma isIso_truncation_map_coskAdj_unit_app (n : ℕ) (X : SSet.{u}) :
    IsIso ((SSet.truncation n).map ((SSet.coskAdj n).unit.app X)) :=
  IsIso.of_isIso_fac_right (hh := IsIso.id _) ((SSet.coskAdj n).left_triangle_components X)

/-- `ALGD-C2-SIMPLEX-R07` (prose, p.40).
`sk_n` and `cosk_n` are fully faithful, so `η^n : id ⇒ tr_n sk_n` and `μ^n : tr_n cosk_n ⇒ id`
are isomorphisms, and `Sk_n ⊣ Csk_n` is idempotent: `Sk_n` sends its unit to isomorphisms
(condition (1) of 「随伴関手」 定理 31). -/
theorem sk_cosk_idempotent (n : ℕ) :
    Nonempty (SSet.Truncated.sk.{u} n).FullyFaithful ∧
    Nonempty (SSet.Truncated.cosk.{u} n).FullyFaithful ∧
    IsIso (SSet.skAdj.{u} n).unit ∧ IsIso (SSet.coskAdj.{u} n).counit ∧
    ∀ X : SSet.{u}, IsIso ((SSet.sk n).map ((skCoskAdj n).unit.app X)) := by
  refine ⟨⟨SimplicialObject.Truncated.sk.fullyFaithful n⟩,
    ⟨SimplicialObject.Truncated.cosk.fullyFaithful n⟩,
    inferInstance, inferInstance, fun X ↦ ?_⟩
  have := isIso_truncation_map_coskAdj_unit_app n X
  change IsIso ((SSet.Truncated.sk n).map ((SSet.truncation n).map
    ((skCoskAdj n).unit.app X)))
  rw [skCoskAdj, Adjunction.comp_unit_app, Functor.map_comp]
  infer_instance

/-- `ALGD-C2-SIMPLEX-30` (命題 30, p.40–41).
For `k ≤ n`, `(ε^n_X)_k : (Sk_n X)_k → X_k` is an isomorphism. -/
theorem isIso_skAdj_counit_app_app (n : ℕ) (X : SSet.{u}) {k : ℕ} (hk : k ≤ n) :
    IsIso (((SSet.skAdj n).counit.app X).app (op ⦋k⦌)) := by
  have := isIso_truncation_map_skAdj_counit_app n X
  exact (inferInstance : IsIso (((SSet.truncation n).map ((SSet.skAdj n).counit.app X)).app
    (op ⟨⦋k⦌, hk⟩)))

/-- The source's `n`-skeletal simplicial sets: `ε^n_X : Sk_n X → X` is an isomorphism. -/
def IsSkeletal (X : SSet.{u}) (n : ℕ) : Prop :=
  IsIso ((SSet.skAdj n).counit.app X)

/-- `ALGD-C2-SIMPLEX-D16`, `ALGD-C2-SIMPLEX-34` (定義 and 命題 34, p.42).
`X` is `n`-skeletal (`ε^n_X` is an isomorphism) iff `X ≅ Sk_n Y` for some `Y`. -/
theorem isSkeletal_iff (X : SSet.{u}) (n : ℕ) :
    IsSkeletal X n ↔ ∃ Y : SSet.{u}, Nonempty ((SSet.sk n).obj Y ≅ X) := by
  refine ⟨fun h ↦ ⟨X, ⟨@asIso _ _ _ _ ((SSet.skAdj n).counit.app X) h⟩⟩, fun ⟨Y, ⟨e⟩⟩ ↦ ?_⟩
  have h₁ : IsIso ((SSet.skAdj n).counit.app ((SSet.sk n).obj Y)) :=
    IsIso.of_isIso_fac_left (hh := IsIso.id _)
      ((SSet.skAdj n).left_triangle_components ((SSet.truncation n).obj Y))
  have h₂ : IsIso ((SSet.skAdj n).counit.app ((SSet.sk n).obj Y) ≫ (𝟭 SSet.{u}).map e.hom) :=
    inferInstance
  exact IsIso.of_isIso_fac_left ((SSet.skAdj n).counit.naturality e.hom)

/-- `ALGD-C2-SIMPLEX-R09` (prose, p.46).
`(Csk_n X)_k ≅ Hom(Sk_n Δ^k, X)`, by `Sk_n ⊣ Csk_n` and the Yoneda lemma. -/
theorem cosk_obj_equiv (n k : ℕ) (X : SSet.{u}) :
    Nonempty ((SSet.cosk n).obj X _⦋k⦌ ≃ ((SSet.sk n).obj Δ[k] ⟶ X)) :=
  ⟨yonedaEquiv.symm.trans ((skCoskAdj n).homEquiv _ _).symm⟩

lemma skCoskAdj_homEquiv_counit (n : ℕ) {A X : SSet.{u}} (g : A ⟶ X) :
    (skCoskAdj n).homEquiv A X ((SSet.skAdj n).counit.app A ≫ g) =
      g ≫ (SSet.coskAdj n).unit.app X := by
  rw [Adjunction.homEquiv_unit, skCoskAdj, Adjunction.comp_unit_app]
  change ((SSet.coskAdj n).unit.app A ≫ (SSet.Truncated.cosk n).map
    ((SSet.skAdj n).unit.app ((SSet.truncation n).obj A))) ≫ (SSet.Truncated.cosk n).map
      ((SSet.truncation n).map ((SSet.skAdj n).counit.app A ≫ g)) = _
  rw [Category.assoc, ← Functor.map_comp, Functor.map_comp (SSet.truncation n),
    ← Category.assoc ((SSet.skAdj n).unit.app _), (SSet.skAdj n).right_triangle_components]
  erw [Category.id_comp]
  exact ((SSet.coskAdj n).unit.naturality g).symm

/-- `ALGD-C2-SIMPLEX-44` (diagram (44), p.47).
Under `X_k ≅ Hom(Δ^k, X)` and `(Csk_n X)_k ≅ Hom(Δ^k, Csk_n X) ≅ Hom(Sk_n Δ^k, X)`, the map
`(κ^n_X)_k` is precomposition with `ε^n_{Δ^k}`: for every `g : A → X`, the transpose of
`g ∘ ε^n_A` is `κ^n_X ∘ g`. -/
theorem coskAdj_unit_app_app_eq (n k : ℕ) (X : SSet.{u}) (x : X _⦋k⦌) :
    (∀ {A : SSet.{u}} (g : A ⟶ X), (skCoskAdj n).homEquiv A X ((SSet.skAdj n).counit.app A ≫ g) =
      g ≫ (SSet.coskAdj n).unit.app X) ∧
    ((SSet.coskAdj n).unit.app X).app (op ⦋k⦌) x =
      yonedaEquiv ((skCoskAdj n).homEquiv Δ[k] X
        ((SSet.skAdj n).counit.app Δ[k] ≫ yonedaEquiv.symm x)) := by
  refine ⟨fun g ↦ skCoskAdj_homEquiv_counit n g, ?_⟩
  rw [skCoskAdj_homEquiv_counit, yonedaEquiv_comp, Equiv.apply_symm_apply]

/-- `ALGD-C2-SIMPLEX-45` (命題 45, p.47).
For `k ≤ n`, `(κ^n_X)_k : X_k → (Csk_n X)_k` is an isomorphism. -/
theorem isIso_coskAdj_unit_app_app (n : ℕ) (X : SSet.{u}) {k : ℕ} (hk : k ≤ n) :
    IsIso (((SSet.coskAdj n).unit.app X).app (op ⦋k⦌)) := by
  have := isIso_truncation_map_coskAdj_unit_app n X
  exact (inferInstance : IsIso (((SSet.truncation n).map ((SSet.coskAdj n).unit.app X)).app
    (op ⟨⦋k⦌, hk⟩)))

/-- `ALGD-C2-SIMPLEX-D17` (定義, p.47).
`X` is `n`-coskeletal iff `κ^n_X : X → Csk_n X` is an isomorphism; this is mathlib's
`IsCoskeletal` (`X` is the right Kan extension of its truncation). -/
theorem isCoskeletal_iff_isIso (X : SSet.{u}) (n : ℕ) :
    X.IsCoskeletal n ↔ IsIso ((SSet.coskAdj n).unit.app X) :=
  SimplicialObject.isCoskeletal_iff_isIso X n

/-- `ALGD-C2-SIMPLEX-46` (命題 46, p.47).
`X` is `n`-coskeletal iff `X ≅ Csk_n Y` for some `Y`. -/
theorem isCoskeletal_iff_exists (X : SSet.{u}) (n : ℕ) :
    X.IsCoskeletal n ↔ ∃ Y : SSet.{u}, Nonempty ((SSet.cosk n).obj Y ≅ X) := by
  rw [isCoskeletal_iff_isIso]
  refine ⟨fun h ↦ ⟨X, ⟨(asIso ((SSet.coskAdj n).unit.app X)).symm⟩⟩, fun ⟨Y, ⟨e⟩⟩ ↦ ?_⟩
  have h₁ : IsIso ((SSet.coskAdj n).unit.app ((SSet.cosk n).obj Y)) :=
    IsIso.of_isIso_fac_right (hh := IsIso.id _)
      ((SSet.coskAdj n).right_triangle_components ((SSet.truncation n).obj Y))
  have h₂ : IsIso ((SSet.coskAdj n).unit.app ((SSet.cosk n).obj Y) ≫
      (SSet.truncation n ⋙ SSet.Truncated.cosk n).map e.hom) := inferInstance
  exact IsIso.of_isIso_fac_left ((SSet.coskAdj n).unit.naturality e.hom)

/-- `ALGD-C2-SIMPLEX-47` (命題 47, p.47).
The nerve of a category is 2-coskeletal. -/
theorem nerve_isCoskeletal (C : Type u) [Category.{v} C] : (nerve C).IsCoskeletal 2 :=
  inferInstance

/-- If `tr_n(i)` is an isomorphism and `X` is `n`-coskeletal, precomposition with `i` is a
bijection `Hom(B, X) → Hom(A, X)`. -/
lemma bijective_precomp_of_isIso_truncation {n : ℕ} {A B X : SSet.{u}} (i : A ⟶ B)
    [IsIso ((SSet.truncation n).map i)] [IsIso ((SSet.coskAdj n).unit.app X)] :
    Function.Bijective (fun h : B ⟶ X ↦ i ≫ h) := by
  let e := asIso ((SSet.coskAdj n).unit.app X)
  let Φ : ∀ Z : SSet.{u}, (Z ⟶ X) ≃ ((SSet.truncation n).obj Z ⟶ (SSet.truncation n).obj X) :=
    fun Z ↦ ((Iso.refl Z).homCongr e).trans ((SSet.coskAdj n).homEquiv Z _).symm
  have hΦ : ∀ h : B ⟶ X, Φ A (i ≫ h) = (SSet.truncation n).map i ≫ Φ B h := fun h ↦ by
    simp only [Φ, Equiv.trans_apply, Iso.homCongr_apply, Iso.refl_inv, Category.id_comp,
      Category.assoc]
    exact (SSet.coskAdj n).homEquiv_naturality_left_symm i (h ≫ e.hom)
  have hpre : Function.Bijective
      (fun g : (SSet.truncation n).obj B ⟶ (SSet.truncation n).obj X ↦
        (SSet.truncation n).map i ≫ g) :=
    ⟨fun g g' hg ↦ (cancel_epi _).1 hg,
      fun g ↦ ⟨inv ((SSet.truncation n).map i) ≫ g, by simp⟩⟩
  have : (fun h : B ⟶ X ↦ i ≫ h) =
      (Φ A).symm ∘ (fun g ↦ (SSet.truncation n).map i ≫ g) ∘ Φ B := by
    funext h
    simp only [Function.comp_apply, ← hΦ, Equiv.symm_apply_apply]
  rw [this]
  exact (Φ A).symm.bijective.comp (hpre.comp (Φ B).bijective)

/-- For `n ≥ 4`, `Λ^{n,k}` and `Δ^n` agree in degrees `≤ 2`, so `tr_2(inc)` is an
isomorphism. -/
lemma isIso_truncation_map_horn_ι {n : ℕ} (hn : 4 ≤ n) (k : Fin (n + 1)) :
    IsIso ((SSet.truncation.{u} 2).map Λ[n, k].ι) := by
  refine @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ fun m ↦ ?_
  obtain ⟨⟨a, ha⟩⟩ := m
  rw [isIso_iff_bijective]
  refine ⟨Subtype.val_injective, fun y ↦ ⟨⟨y, ?_⟩, rfl⟩⟩
  have h := horn_obj_eq_univ.{u} k a.len (by change a.len ≤ 2 at ha; omega)
  exact (Set.ext_iff.1 h y).2 trivial

/-- `ALGD-C2-SIMPLEX-48` (命題 48, p.47–48).
If `X` is 2-coskeletal, `n ≥ 4` and `0 ≤ k ≤ n`, every `f : Λ^{n,k} → X` extends uniquely along
`inc : Λ^{n,k} → Δ^n`. -/
theorem existsUnique_horn_filler {X : SSet.{u}} [X.IsCoskeletal 2] {n : ℕ} (hn : 4 ≤ n)
    (k : Fin (n + 1)) (f : (Λ[n, k] : SSet.{u}) ⟶ X) :
    ∃! h : Δ[n] ⟶ X, Λ[n, k].ι ≫ h = f := by
  have := isIso_truncation_map_horn_ι.{u} hn k
  have := (isCoskeletal_iff_isIso X 2).1 inferInstance
  exact (bijective_precomp_of_isIso_truncation (n := 2) Λ[n, k].ι).existsUnique f

/-! ## §6 Quasi-categories -/

/-- `ALGD-C2-SIMPLEX-D18` (定義, p.56).
`X` is a quasi-category (weak Kan complex) iff for `0 < k < n` every `f : Λ^{n,k} → X` extends
along `inc : Λ^{n,k} → Δ^n`. -/
theorem quasicategory_iff (X : SSet.{u}) :
    X.Quasicategory ↔ ∀ (n : ℕ) (k : Fin (n + 1)), 0 < k → k < Fin.last n →
      ∀ f : (Λ[n, k] : SSet.{u}) ⟶ X, ∃ h : Δ[n] ⟶ X, Λ[n, k].ι ≫ h = f := by
  refine ⟨fun hX n k h0 hl f ↦ ?_, fun H ↦ ⟨fun n i σ₀ h0 hl ↦ ?_⟩⟩
  · obtain _ | _ | n := n
    · rw [Fin.lt_def] at h0
      simp at h0
    · rw [Fin.lt_def] at h0 hl
      simp at h0 hl
      omega
    · obtain ⟨h, hh⟩ := hX.hornFilling' f h0 hl
      exact ⟨h, hh.symm⟩
  · obtain ⟨h, hh⟩ := H (n + 2) i h0 hl σ₀
    exact ⟨h, hh.symm⟩

/-- `ALGD-C2-SIMPLEX-R11` (prose, p.55–56).
Quasi-categories generalize both Kan complexes and nerves of categories: every Kan complex and
every nerve is a quasi-category. -/
theorem quasicategory_of_kanComplex_of_nerve :
    (∀ X : SSet.{u}, X.KanComplex → X.Quasicategory) ∧
    ∀ (C : Type u) [Category.{u} C], (nerve C).Quasicategory :=
  ⟨fun _ _ ↦ inferInstance, fun _ _ ↦ inferInstance⟩

