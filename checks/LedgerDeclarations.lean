import ProjectEpisteme

/-!
Every ledger row whose status is `existing`, `bridged`, or `new-proved` names a Lean
declaration. This check fails if one of them does not exist in the built library.

Generated by `python3 checks/ledger.py --write` from `docs/ledger/`. Do not edit it by hand.
-/

open Lean Elab Command

private def ledgerDeclarations : List (String × Name) := [
  ("ALGD-C1-YONEDA-D02", `CategoryTheory.yoneda),
  ("ALGD-C1-YONEDA-D04", `CategoryTheory.yoneda),
  ("ALGD-C1-YONEDA-01", `ProjectEpisteme.AlgD.Yoneda.yoneda_bijective),
  ("ALGD-C1-YONEDA-02", `ProjectEpisteme.AlgD.Yoneda.yoneda_map_bijective),
  ("ALGD-C1-YONEDA-03", `ProjectEpisteme.AlgD.Yoneda.isIso_iff_isIso_yonedaEquiv),
  ("ALGD-C1-YONEDA-04", `ProjectEpisteme.AlgD.Yoneda.nonempty_iso_of_yoneda_iso),
  ("ALGD-C1-YONEDA-05", `ProjectEpisteme.AlgD.Yoneda.nonempty_iso_of_natural_equiv_hom_to),
  ("ALGD-C1-YONEDA-06", `ProjectEpisteme.AlgD.Yoneda.nonempty_iso_of_natural_equiv_hom_from),
  ("ALGD-C1-YONEDA-07", `ProjectEpisteme.AlgD.Yoneda.yonedaEquiv_symm_natural_iff_natural),
  ("ALGD-C1-YONEDA-09", `ProjectEpisteme.AlgD.Yoneda.nonempty_iso_of_yoneda_comp_iso),
  ("ALGD-C1-YONEDA-10", `ProjectEpisteme.AlgD.Yoneda.yonedaEquiv_natural_in_object),
  ("ALGD-C1-YONEDA-11", `ProjectEpisteme.AlgD.Yoneda.yonedaEquiv_natural_in_presheaf)
]

run_cmd do
  let env ← getEnv
  let missing := ledgerDeclarations.filter fun (_, name) => !env.contains name
  unless missing.isEmpty do
    throwError m!"Ledger declarations not found: \
      {", ".intercalate (missing.map fun (id, name) => s!"{id} {name}")}"
  logInfo m!"All {ledgerDeclarations.length} ledger declarations exist."
